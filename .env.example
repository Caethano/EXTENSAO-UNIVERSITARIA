# Copie para .env e ajuste. O .env é opcional: sem ele, valem os valores abaixo.
# O .env não vai para o Git (está no .gitignore).

# Portas (só nesta máquina: 127.0.0.1)
WP_PORT=8080
MAIL_PORT=8025

# Endereço do site. Padrão: http://localhost:<WP_PORT>
# WP_URL=http://localhost:8080

# Instalação do WordPress — usados só na primeira subida
WP_TITLE=Festa dos Amigos 2026
WP_ADMIN_USER=admin
# Vazio: a senha é sorteada e aparece uma vez em "docker compose logs wordpress"
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@festa.local
WP_LOCALE=pt_BR
WP_TIMEZONE=America/Sao_Paulo

# 1 = avisos do PHP em "docker compose logs wordpress"
WP_DEBUG=0

# Banco de dados. Só é acessível dentro da rede do Docker (não abre porta).
# Defina antes da primeira subida: depois o MariaDB não troca a senha sozinho.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
